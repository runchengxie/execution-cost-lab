---
interface Props { lang?: "en" | "zh-CN"; }
const { lang = "en" } = Astro.props;
const zh = lang === "zh-CN";
const bundle = import.meta.env.BASE_URL.replace(/\/$/, "") + "/reading.enc";
---
  <section class="frame section" id="private-reading" aria-labelledby="reading-title">
    <h2 id="reading-title" data-research-copy="readingTitle">{zh ? "完整研究笔记" : "Full research notes"}</h2>
    <section id="unlock">
      <p class="lead" data-research-copy="readingIntro">{zh ? "输入口令，在当前浏览器解锁研究资料。" : "Enter your passphrase to read the encrypted notes in this browser."}</p>
      <form id="reading-form" data-bundle={bundle}>
        <div class="controls">
          <label><span data-research-copy="readingPassword">{zh ? "阅读口令" : "Reading passphrase"}</span>
            <input type="password" id="reading-password" required autocomplete="off" spellcheck="false">
          </label>
        </div>
        <button type="submit" data-research-copy="readingUnlock">{zh ? "解锁" : "Unlock"}</button>
        <p role="status" id="reading-status"></p>
      </form>
    </section>
    <section id="reader" hidden>
      <button type="button" id="reading-lock" data-research-copy="readingLock">{zh ? "锁定" : "Lock"}</button>
      <iframe id="reading-document" title={zh ? "加密研究笔记" : "Encrypted research notes"} sandbox="allow-scripts" referrerpolicy="no-referrer"></iframe>
    </section>
  </section>
  <style>
    input { background: var(--panel); color: var(--ink); border: 1px solid var(--line); padding: .6rem; font: inherit; width: min(28rem, 82vw); }
    iframe { display: block; width: 100%; height: 83vh; border: 1px solid var(--line); margin-top: .75rem; background: var(--panel); }
  </style>
  <script>
    const form = document.querySelector<HTMLFormElement>("#reading-form")!;
    const password = document.querySelector<HTMLInputElement>("#reading-password")!;
    const status = document.querySelector<HTMLElement>("#reading-status")!;
    const unlock = document.querySelector<HTMLElement>("#unlock")!;
    const reader = document.querySelector<HTMLElement>("#reader")!;
    const frame = document.querySelector<HTMLIFrameElement>("#reading-document")!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const lock = document.querySelector<HTMLButtonElement>("#reading-lock")!;

    let documentUrl: string | undefined;

    const offsetKey = (locale: string) => `execution-reading-v1-offset-${locale}`;

    function syncReadingLanguage() {
      const locale = document.documentElement.lang === "zh-CN" ? "zh-CN" : "en";
      frame.title = locale === "zh-CN" ? "加密研究笔记" : "Encrypted research notes";
      if (!documentUrl) return;
      let readingOffset = 0;
      try {
        readingOffset = Number(localStorage.getItem(offsetKey(locale))) || 0;
      } catch {
        // Reading still works with storage disabled.
      }
      frame.contentWindow?.postMessage({ readingLocale: locale, readingOffset }, "*");
    }

    window.addEventListener("message", (event) => {
      if (!documentUrl || event.source !== frame.contentWindow || event.origin !== "null") return;
      const { readingLocale, readingOffset } = event.data ?? {};
      if (readingLocale !== "en" && readingLocale !== "zh-CN") return;
      if (!Number.isSafeInteger(readingOffset) || readingOffset < 0 || readingOffset > 10_000_000) return;
      try {
        localStorage.setItem(offsetKey(readingLocale), String(readingOffset));
      } catch {
        // Reading still works with storage disabled.
      }
    });

    frame.addEventListener("load", syncReadingLanguage);
    new MutationObserver(syncReadingLanguage).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["lang"],
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submit.disabled = true;
      const zh = document.documentElement.lang === "zh-CN";
      status.textContent = zh ? "正在解锁…" : "Unlocking…";
      try {
        const response = await fetch(form.dataset.bundle!, { credentials: "omit" });
        if (!response.ok) throw new Error("Bundle unavailable");
        const sealed = new Uint8Array(await response.arrayBuffer());
        if (sealed.length <= 44) throw new Error("Invalid bundle");
        const material = await crypto.subtle.importKey("raw", new TextEncoder().encode(password.value.trim()), "PBKDF2", false, ["deriveKey"]);
        const key = await crypto.subtle.deriveKey(
          { name: "PBKDF2", hash: "SHA-256", salt: sealed.slice(0, 16), iterations: 600_000 },
          material, { name: "AES-GCM", length: 256 }, false, ["decrypt"],
        );
        const clear = await crypto.subtle.decrypt({ name: "AES-GCM", iv: sealed.slice(16, 28) }, key, sealed.slice(28));
        documentUrl = URL.createObjectURL(new Blob([clear], { type: "text/html;charset=utf-8" }));
        frame.src = documentUrl;
        password.value = "";
        unlock.hidden = true;
        reader.hidden = false;
        lock.focus();
        status.textContent = "";
      } catch {
        status.textContent = zh ? "解锁失败。请检查口令和网络连接。" : "Could not unlock. Check the passphrase and connection.";
      } finally {
        submit.disabled = false;
      }
    });

    lock.addEventListener("click", () => {
      frame.removeAttribute("src");
      if (documentUrl) URL.revokeObjectURL(documentUrl);
      documentUrl = undefined;
      reader.hidden = true;
      unlock.hidden = false;
      password.focus();
    });
  </script>
